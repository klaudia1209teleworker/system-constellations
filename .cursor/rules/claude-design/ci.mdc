## Tailwind Config 模板

```ts
import type { Config } from 'tailwindcss'

const config: Config = {
  content: ['./index.html', './src/**/*.{ts,tsx}'],
  theme: {
    extend: {
      colors: {
        primary: '#5C3D2E',
        secondary: '#C4A484',
        text: '#2A211C',
        highlight: '#8B3A2F',
        accent: '#6B7F5A',
        bg: '#EDE6DB',
        muted: '#7A6E64',
        border: '#D2C6B6',
        surface: '#F7F2EA',
      },
      fontFamily: {
        sans: ['"IBM Plex Sans"', '"Noto Sans TC"', 'sans-serif'],
        serif: ['"Libre Baskerville"', 'serif'],
      },
    },
  },
  plugins: [],
}

export default config
```

